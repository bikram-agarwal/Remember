<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="180dp"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_favorites_label"
            android:textColor="@color/widget_preview_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/widget_preview_small_action"
            android:contentDescription="@string/widget_refresh_cd"
            android:padding="4dp"
            android:src="@drawable/ic_widget_refresh"
            android:tint="@color/widget_preview_on_surface" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_preview_small_action"
            android:contentDescription="@string/widget_create_new_note"
            android:padding="4dp"
            android:src="@drawable/ic_widget_note_add"
            android:tint="@color/widget_preview_on_surface" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_preview_small_action"
            android:contentDescription="@string/widget_create_new_list"
            android:padding="4dp"
            android:src="@drawable/ic_widget_list_add"
            android:tint="@color/widget_preview_on_surface" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_preview_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <TextView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_preview_icon_circle"
            android:gravity="center"
            android:text="F"
            android:textColor="@color/widget_preview_on_surface"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Favorite recipes"
                android:textColor="@color/widget_preview_on_surface"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="11dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Dinners, snacks, desserts, weekend meal ideas, and grocery shortcuts"
                android:textColor="@color/widget_preview_muted"
                android:textSize="8sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_preview_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <TextView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_preview_icon_circle"
            android:gravity="center"
            android:text="L"
            android:textColor="@color/widget_preview_on_surface"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Books to revisit"
                android:textColor="@color/widget_preview_on_surface"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="11dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Favorite passages, quotes, chapters to revisit, and notes for book club"
                android:textColor="@color/widget_preview_muted"
                android:textSize="8sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_preview_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <TextView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_preview_icon_circle"
            android:gravity="center"
            android:text="N"
            android:textColor="@color/widget_preview_on_surface"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Wife's Birthday"
                android:textColor="@color/widget_preview_on_surface"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="11dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Buy gifts, make dinner reservations, send photos to family"
                android:textColor="@color/widget_preview_muted"
                android:textSize="8sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
